# M2.2 local env (copy to .env.m22; .env.m22 is gitignored)
# Canonical weights: local snapshots under M22_MODELS_ROOT (curl download_m22.sh).
# HF_HOME is only for incidental hub resolves — NOT the primary weight tree.
# Do NOT use ~/.cache/huggingface.

MIAOWANGTOWN_ROOT=/Users/cloud/dev/game/喵汪小镇/miaowangtown
M22_MODELS_ROOT=/Users/cloud/dev/models/m22
HF_HOME=/Users/cloud/dev/models/m22/hf_home
# Optional: HUGGING_FACE_HUB_TOKEN=...
PYTORCH_ENABLE_MPS_FALLBACK=1
HF_HUB_DISABLE_TELEMETRY=1
